generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(cuid())
  googleSub   String   @unique
  email       String   @unique
  displayName String
  avatarUrl   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sessions    Session[]
  invites     Invite[]
  referredBy  Referral? @relation("referee")
  referrals   Referral[] @relation("referrer")
  memberships    ChatMember[]
  messages       Message[]
  hiddenMessages MessageHidden[]
  uploads        Upload[]
  contactsSaved  ContactOverride[] @relation("owner")
  savedAs        ContactOverride[] @relation("contact")
}

model Invite {
  id        String    @id @default(cuid())
  code      String    @unique
  creatorId String
  maxUses   Int?
  uses      Int       @default(0)
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  creator   User       @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  referrals Referral[]
}

model Referral {
  id         String   @id @default(cuid())
  inviteId   String
  referrerId String
  refereeId  String   @unique
  createdAt  DateTime @default(now())

  invite   Invite @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  referrer User   @relation("referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referee  User   @relation("referee", fields: [refereeId], references: [id], onDelete: Cascade)
}

model Session {
  id               String      @id @default(cuid())
  userId           String
  platform         String
  deviceName       String?
  refreshTokenHash String      @unique
  createdAt        DateTime    @default(now())
  lastUsedAt       DateTime    @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  pushTokens PushToken[]

  @@index([userId])
}

model PushToken {
  id        String  @id @default(cuid())
  sessionId String
  provider  String
  token     String  @db.Text

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, provider])
}

model ChangeEvent {
  id        BigInt   @id @default(autoincrement())
  userId    String
  type      String
  payload   Json
  createdAt DateTime @default(now())

  @@index([userId, id])
}

model Chat {
  id            String   @id @default(cuid())
  type          String   @default("direct")
  directKey     String?  @unique
  createdAt     DateTime @default(now())
  lastMessageAt DateTime @default(now())

  members  ChatMember[]
  messages Message[]
}

model ChatMember {
  chatId            String
  userId            String
  joinedAt          DateTime  @default(now())
  archived          Boolean   @default(false)
  muted             Boolean   @default(false)
  pinned            Boolean   @default(false)
  autoDeleteSecs    Int?
  lastDeliveredMessageId String?
  lastDeliveredAt        DateTime?
  lastReadMessageId String?
  lastReadAt        DateTime?
  hidden            Boolean   @default(false)
  clearedAt         DateTime?

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([chatId, userId])
  @@index([userId])
}

model Message {
  id        String    @id @default(cuid())
  chatId    String
  senderId  String
  clientId  String
  type      String    @default("text")
  text      String?
  entities  Json?
  spoiler   Boolean   @default(false)
  attachmentId String?
  replyToId String?
  createdAt DateTime  @default(now())
  editedAt  DateTime?
  deletedAt DateTime?

  chat    Chat            @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sender  User            @relation(fields: [senderId], references: [id], onDelete: Cascade)
  replyTo Message?        @relation("replies", fields: [replyToId], references: [id], onDelete: SetNull)
  attachment Upload?      @relation(fields: [attachmentId], references: [id], onDelete: SetNull)
  replies Message[]       @relation("replies")
  hidden  MessageHidden[]

  @@unique([senderId, clientId])
  @@index([chatId, createdAt])
}

model MessageHidden {
  userId    String
  messageId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@id([userId, messageId])
  @@index([messageId])
}

model ContactOverride {
  ownerId     String
  contactId   String
  displayName String?
  photoKey    String?
  updatedAt   DateTime @updatedAt

  owner   User @relation("owner", fields: [ownerId], references: [id], onDelete: Cascade)
  contact User @relation("contact", fields: [contactId], references: [id], onDelete: Cascade)

  @@id([ownerId, contactId])
}

model Upload {
  id         String   @id @default(cuid())
  ownerId    String
  kind       String
  status     String   @default("pending")
  name       String
  mime       String
  size       Int
  key        String   @unique
  mainKey    String?
  mainMime   String?
  thumbKey   String?
  width      Int?
  height     Int?
  durationMs Int?
  waveform   Json?
  error      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  owner    User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([ownerId])
  @@index([status, createdAt])
}
