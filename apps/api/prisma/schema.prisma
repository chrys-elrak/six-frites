generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String    @id @default(cuid())
  googleSub       String    @unique
  email           String    @unique
  displayName     String
  avatarUrl       String?
  avatarKey       String?
  contactCode     String    @unique @default(dbgenerated("random_code()"))
  askCode         String    @unique @default(dbgenerated("random_code()"))
  askName         String?
  askAvatarKey    String?
  /// The line at the top of their link, instead of the app's "Send me anonymous messages!".
  askPrompt       String?
  /// When the user last replaced their anonymous link; what they got before came through an old one.
  askRenewedAt    DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  /// When they accepted the Terms of Service and Privacy Policy; the apps ask once, before anything else.
  termsAcceptedAt DateTime?
  /// When they went through or skipped the quick tour; everyone who joined before it came counts as having seen it.
  tourSeenAt      DateTime?
  bannedAt        DateTime?
  banReason       String?
  /// When a timed ban is lifted on its own; null while `bannedAt` is set means it lasts until an admin lifts it.
  bannedUntil     DateTime?
  /// What a ban takes away: "full" shuts the account, "chat" leaves only anonymous messages and support, like a guest.
  banScope        String    @default("full")
  /// An admin's authenticator secret, in base32; moderation stays shut until it is set.
  totpSecret      String?
  /// The time step of the last authenticator code accepted, so no code works twice.
  totpStep        Int?
  lastSeenAt      DateTime?
  deletedAt       DateTime?
  backupKeyId     String?
  backupPinHash   String?
  backupWrapped   String?
  backupPinTries  Int       @default(0)
  appLockHash     String?
  inviteLimit     Int       @default(10)
  queuedAt        DateTime?
  guest           Boolean   @default(false)
  /// The app language last seen for this account, for what Frite Bot says.
  locale          String?
  adsDisabled     Boolean   @default(false)
  /// Turned off the questions the Six Frites bot sends to their anonymous inbox.
  anonBotDisabled Boolean   @default(false)
  /// When the bot next writes to them; null until the worker picks a time.
  anonBotAt       DateTime?
  /// Asked not to get emails from the app, from the link at the bottom of one.
  mailOptOut      Boolean   @default(false)
  /// When the app last emailed them that their account has been quiet.
  inactiveMailAt  DateTime?
  /// When the app last emailed a guest to share their anonymous link.
  anonMailAt      DateTime?
  quickReactions  String[]  @default([])
  /// When they last opened their notifications; anything newer counts as unread.
  notificationsSeenAt DateTime?

  sessions       Session[]
  deviceLinks    DeviceLink[]
  invites        Invite[]
  askLinks       AskLink[]
  contactLinks   ContactLink[]
  referredBy     Referral?          @relation("referee")
  referrals      Referral[]         @relation("referrer")
  memberships    ChatMember[]
  chatBans       ChatBan[]
  messages       Message[]
  hiddenMessages MessageHidden[]
  uploads        Upload[]
  messageViews   MessageView[]
  reactions      MessageReaction[]
  blocking       Block[]            @relation("blocker")
  blockedBy      Block[]            @relation("blocked")
  contactsSaved  ContactOverride[]  @relation("owner")
  savedAs        ContactOverride[]  @relation("contact")
  scheduled      ScheduledMessage[]
  stickerPacks   StickerPack[]
  savedPacks     SavedStickerPack[]
  reportsMade    Report[]           @relation("reporter")
  reportsAgainst Report[]           @relation("target")
  devices        Device[]
  messageBackups MessageBackup[]
  checklistMarks ChecklistMark[]
  gameMoves      GameMove[]
  anonReceived   AnonMessage[]      @relation("anonRecipient")
  anonSent       AnonMessage[]      @relation("anonSender")
  anonBlocking   AnonBlock[]        @relation("anonBlocker")
  anonBlockedBy  AnonBlock[]        @relation("anonBlocked")
  stories        Story[]
  storyViews     StoryView[]
  note           Note?
  noteViews      NoteView[]
  notifications  Notification[]     @relation("notified")
  notified       Notification[]     @relation("notifier")
  pokesSent      Poke[]             @relation("poker")
  pokesReceived  Poke[]             @relation("poked")
  mailsReceived  MailLog[]          @relation("mailed")
  mailsCaused    MailLog[]          @relation("mailCause")

  @@index([anonBotAt])
}

model Report {
  id           String    @id @default(cuid())
  reporterId   String
  targetId     String
  messageId    String?
  reason       String
  note         String?
  snapshot     Json
  status       String    @default("open")
  resolution   String?
  resolvedById String?
  resolvedAt   DateTime?
  createdAt    DateTime  @default(now())

  reporter User @relation("reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  target   User @relation("target", fields: [targetId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([targetId, status])
}

model ContactLink {
  id        String   @id @default(cuid())
  code      String   @unique @default(dbgenerated("random_code()"))
  userId    String
  expiresAt DateTime
  /// Null: anyone, until it expires. Once that many people added me with it, it expires.
  maxUses   Int?
  uses      Int      @default(0)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Invite {
  id        String    @id @default(cuid())
  code      String    @unique
  creatorId String
  message   String?
  maxUses   Int?
  uses      Int       @default(0)
  expiresAt DateTime?
  revokedAt DateTime?
  /// Taken off the creator's list once it no longer works; its referrals stay.
  hiddenAt  DateTime?
  createdAt DateTime  @default(now())

  creator   User       @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  referrals Referral[]

  @@index([creatorId, createdAt])
}

model Referral {
  id         String   @id @default(cuid())
  inviteId   String
  referrerId String
  refereeId  String   @unique
  createdAt  DateTime @default(now())

  invite   Invite @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  referrer User   @relation("referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referee  User   @relation("referee", fields: [refereeId], references: [id], onDelete: Cascade)
}

/// A computer waiting to be signed in by scanning its QR code with a signed-in phone. Lives two minutes.
model DeviceLink {
  id         String   @id @default(cuid())
  secretHash String
  platform   String
  deviceName String?
  deviceId   String?
  /// Who approved it from their phone; the computer gets a session for them on its next check.
  userId     String?
  /// The backup key sealed by the phone to the computer's one-time key, which the server never sees.
  sealedKey  String?
  createdAt  DateTime @default(now())
  expiresAt  DateTime

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model Session {
  id               String    @id @default(cuid())
  userId           String
  platform         String
  deviceName       String?
  /// A random ID the app keeps for the browser or phone, so a ban or an anonymous block reaches other accounts on it.
  deviceId         String?
  refreshTokenHash String    @unique
  createdAt        DateTime  @default(now())
  lastUsedAt       DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?
  /// When an admin last entered an authenticator code on this session.
  adminVerifiedAt  DateTime?

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  pushTokens PushToken[]
  device     Device?

  @@index([userId])
  @@index([deviceId])
}

model Device {
  id              String   @id @default(cuid())
  userId          String
  sessionId       String   @unique
  signPub         String
  dhPub           String
  dhSig           String
  signedPreKeyId  Int
  signedPreKey    String
  signedPreKeySig String
  signedPreKeyAt  DateTime @default(now())
  createdAt       DateTime @default(now())

  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  session        Session           @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  oneTimePreKeys OneTimePreKey[]
  envelopes      MessageEnvelope[]

  @@index([userId])
}

model OneTimePreKey {
  deviceId String
  keyId    Int
  pub      String

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@id([deviceId, keyId])
}

model MessageEnvelope {
  messageId String
  deviceId  String
  envelope  Json

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  device  Device  @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@id([messageId, deviceId])
  @@index([deviceId])
}

model MessageBackup {
  messageId String
  userId    String
  sealed    String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
  @@index([userId])
}

model PushToken {
  id        String @id @default(cuid())
  sessionId String
  provider  String
  token     String @db.Text
  locale    String @default("en")

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, provider])
}

model ChangeEvent {
  id        BigInt   @id @default(autoincrement())
  userId    String
  type      String
  payload   Json
  createdAt DateTime @default(now())

  @@index([userId, id])
}

model Chat {
  id              String    @id @default(cuid())
  type            String    @default("direct")
  directKey       String?   @unique
  createdAt       DateTime  @default(now())
  lastMessageAt   DateTime  @default(now())
  autoDeleteSecs  Int?
  theme           String?
  vanish          Boolean   @default(false)
  encryptedAt     DateTime?
  /// Set on a chat with support: the person being helped, who sees the other side as Six Frites.
  supportUserId   String?
  /// Support closed the conversation; the next message opens it again.
  supportClosedAt DateTime?
  /// A group's name; groups have type "group" and no directKey.
  title           String?
  description     String?
  photoKey        String?
  /// The code in the group's link, the only way in; resetting it makes the old link stop working.
  inviteCode      String?   @unique
  /// How many members a group can have.
  maxMembers      Int?
  /// Off: only a group's owner and admins send messages; members read and react.
  membersCanWrite Boolean   @default(true)
  /// Off: only a group's owner and admins see its link, so only they can bring people in.
  membersCanInvite Boolean  @default(true)

  members   ChatMember[]
  messages  Message[]
  scheduled ScheduledMessage[]
  bans      ChatBan[]
}

/// Someone removed from a group, who can't come back through its link.
model ChatBan {
  chatId    String
  userId    String
  createdAt DateTime @default(now())

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([chatId, userId])
  @@index([userId])
}

model ChatMember {
  chatId                 String
  userId                 String
  joinedAt               DateTime  @default(now())
  archived               Boolean   @default(false)
  muted                  Boolean   @default(false)
  mutedUntil             DateTime?
  pinned                 Boolean   @default(false)
  lastDeliveredMessageId String?
  lastDeliveredAt        DateTime?
  lastReadMessageId      String?
  lastReadAt             DateTime?
  hidden                 Boolean   @default(false)
  clearedAt              DateTime?
  /// Only bot accounts show their own name and photo; people always appear under an alias.
  showProfile            Boolean   @default(false)
  safeView               Boolean   @default(false)
  draft                  String?
  draftSealed            Boolean   @default(false)
  draftAt                DateTime?
  /// In a group: owner, admin or member.
  role                   String    @default("member")
  /// In a group: the name and photo this member shows there instead of their alias.
  nickname               String?
  photoKey               String?

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([chatId, userId])
  @@index([userId])
}

model Message {
  id                String    @id @default(cuid())
  chatId            String
  senderId          String
  clientId          String
  type              String    @default("text")
  text              String?
  entities          Json?
  spoiler           Boolean   @default(false)
  effect            String?
  silent            Boolean   @default(false)
  bump              Boolean   @default(false)
  vanish            Boolean   @default(false)
  maxViews          Int?
  ttlSeconds        Int?
  expiredAt         DateTime?
  resendCount       Int       @default(0)
  purgedAt          DateTime?
  attachmentId      String?
  stickerId         String?
  replyToId         String?
  groupId           String?
  /// In a group, the message this one comments on; comments stay out of the chat's own list.
  threadId          String?
  /// On a group message: how many comments it has, and whether an admin closed them.
  threadCount       Int       @default(0)
  threadClosed      Boolean   @default(false)
  /// Comments close by themselves after this many from people other than the author, or at this time.
  threadLimit       Int?
  threadClosesAt    DateTime?
  action            Json?
  location          Json?
  checklist         Json?
  /// The story this answers, as it was then: { id, ownerId, kind, text, background }.
  story             Json?
  game              Json?
  encrypted         Boolean   @default(false)
  senderDevice      String?
  /// When someone who couldn't decrypt it asked the sender to encrypt it again for their devices, and who.
  resealRequestedAt DateTime?
  resealRequestedBy String?
  /// When the sender's device couldn't read it either, so it couldn't be encrypted again.
  resealFailedAt    DateTime?
  sentAt            DateTime?
  arrivedAt         DateTime?
  createdAt         DateTime  @default(now())
  editedAt          DateTime?
  deletedAt         DateTime?
  deletedById       String?
  expiresAt         DateTime?
  /// When someone pinned it to the top of the chat, for both people.
  pinnedAt          DateTime?

  chat             Chat               @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sender           User               @relation(fields: [senderId], references: [id], onDelete: Cascade)
  replyTo          Message?           @relation("replies", fields: [replyToId], references: [id], onDelete: SetNull)
  attachment       Upload?            @relation(fields: [attachmentId], references: [id], onDelete: SetNull)
  sticker          Sticker?           @relation(fields: [stickerId], references: [id], onDelete: SetNull)
  replies          Message[]          @relation("replies")
  scheduledReplies ScheduledMessage[]
  hidden           MessageHidden[]
  views            MessageView[]
  reactions        MessageReaction[]
  envelopes        MessageEnvelope[]
  backups          MessageBackup[]
  marks            ChecklistMark[]
  moves            GameMove[]

  @@unique([senderId, clientId])
  @@index([chatId, createdAt])
  @@index([threadId, createdAt])
  @@index([expiresAt])
}

model ChecklistMark {
  messageId String
  item      Int
  userId    String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, item])
  @@index([userId])
}

model GameMove {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  move      Json
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([messageId, createdAt])
  @@index([userId])
}

model ScheduledMessage {
  id           String   @id @default(cuid())
  chatId       String
  senderId     String
  clientId     String
  text         String?
  entities     Json?
  spoiler      Boolean  @default(false)
  silent       Boolean  @default(false)
  maxViews     Int?
  ttlSeconds   Int?
  attachmentId String?  @unique
  stickerId    String?
  replyToId    String?
  groupId      String?
  type         String?
  location     Json?
  checklist    Json?
  encrypted    Json?
  senderDevice String?
  sendAt       DateTime
  createdAt    DateTime @default(now())

  chat       Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sender     User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  attachment Upload?  @relation(fields: [attachmentId], references: [id], onDelete: SetNull)
  replyTo    Message? @relation(fields: [replyToId], references: [id], onDelete: SetNull)

  @@unique([senderId, clientId])
  @@index([chatId, senderId])
  @@index([sendAt])
}

model MessageHidden {
  userId    String
  messageId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@id([userId, messageId])
  @@index([messageId])
}

model ContactOverride {
  ownerId     String
  contactId   String
  displayName String?
  photoKey    String?
  label       String?
  updatedAt   DateTime @updatedAt

  owner   User @relation("owner", fields: [ownerId], references: [id], onDelete: Cascade)
  contact User @relation("contact", fields: [contactId], references: [id], onDelete: Cascade)

  @@id([ownerId, contactId])
}

model Upload {
  id          String   @id @default(cuid())
  ownerId     String
  kind        String
  status      String   @default("pending")
  name        String
  mime        String
  size        Int
  storedBytes Int?
  key         String   @unique
  mainKey     String?
  mainMime    String?
  thumbKey    String?
  width       Int?
  height      Int?
  durationMs  Int?
  waveform    Json?
  encrypted   Boolean  @default(false)
  multipartId String?
  error       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner     User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  messages  Message[]
  scheduled ScheduledMessage?
  sticker   Sticker?
  story     Story?

  @@index([ownerId])
  @@index([status, createdAt])
}

model StickerPack {
  id        String    @id @default(cuid())
  ownerId   String?
  title     String
  builtin   Boolean   @default(false)
  createdAt DateTime  @default(now())
  bannedAt  DateTime?

  owner    User?              @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  stickers Sticker[]
  savedBy  SavedStickerPack[]

  @@index([ownerId])
}

model Sticker {
  id        String    @id @default(cuid())
  packId    String
  emoji     String
  /// What it's called, from its file name (or the emoji's name for the Noto ones), for finding it with /sticker.
  name      String?
  uploadId  String?   @unique
  lottieUrl String?
  position  Int       @default(0)
  removedAt DateTime?
  bannedAt  DateTime?
  createdAt DateTime  @default(now())

  pack     StickerPack @relation(fields: [packId], references: [id], onDelete: Cascade)
  upload    Upload?           @relation(fields: [uploadId], references: [id], onDelete: SetNull)
  messages  Message[]
  reactions MessageReaction[]

  @@index([packId, position])
}

model SavedStickerPack {
  userId    String
  packId    String
  createdAt DateTime @default(now())

  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  pack StickerPack @relation(fields: [packId], references: [id], onDelete: Cascade)

  @@id([userId, packId])
}

model MessageView {
  messageId     String
  userId        String
  count         Int      @default(0)
  firstViewedAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
}

model MessageReaction {
  messageId String
  userId    String
  /// The emoji, or `sticker:<id>` / `gif:<id>` for a sticker or GIF reaction.
  emoji     String
  stickerId String?
  gifKey    String?
  gifWidth  Int?
  gifHeight Int?
  createdAt DateTime @default(now())

  message Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sticker Sticker? @relation(fields: [stickerId], references: [id], onDelete: SetNull)

  @@id([messageId, userId, emoji])
}

model Block {
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
}

/// A message sent through someone's ask link. The recipient never learns who sent it; moderators can.
model AnonMessage {
  id                 String    @id @default(cuid())
  recipientId        String
  /// Null when the Six Frites bot sent it.
  senderId           String?
  /// Which of the bot's lines this is, so nobody gets the same one twice.
  botLine            Int?
  text               String
  /// The recipient's own prompt when it was sent, so a shared card shows what it answered; null for the app's.
  prompt             String?
  /// Formatting ranges of `text`, as on chat messages; null when it has none.
  entities           Json?
  photoKey           String?
  /// A GIF: the MP4 in shared storage that chat GIFs use too, so it is never deleted with the message.
  gifKey             String?
  gifWidth           Int?
  gifHeight          Int?
  /// A voice message, re-encoded to AAC, stored under the recipient like the photo.
  voiceKey           String?
  voiceMs            Int?
  voiceWaveform      Int[]     @default([])
  createdAt          DateTime  @default(now())
  /// Hidden from the sender's sent list; the message stays, for the recipient and the moderators.
  senderDeletedAt    DateTime?
  /// Hidden from the recipient's inbox, by them or because they blocked the sender; moderators still see it.
  recipientDeletedAt DateTime?

  recipient User  @relation("anonRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  sender    User? @relation("anonSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([recipientId, createdAt])
  @@index([senderId, createdAt])
}

/// Someone who can no longer send `blockerId` anonymous messages, kept apart from Block so blocking never reveals who it was.
/// A second link to someone's anonymous messages that stops working at `expiresAt`, for a story; their own link stays.
model AskLink {
  id        String   @id @default(cuid())
  code      String   @unique
  userId    String
  /// The title at the top of this link, instead of the user's own prompt.
  prompt    String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model AnonBlock {
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("anonBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("anonBlocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
}

/// Text, a photo or a video the user's contacts can open until `expiresAt`; the worker deletes it then.
model Story {
  id         String    @id @default(cuid())
  userId     String
  text       String?
  background String?
  uploadId   String?   @unique
  /// A GIF on top: the MP4 in shared storage that chat GIFs use too, so it is never deleted with the story.
  gifKey     String?
  gifWidth   Int?
  gifHeight  Int?
  location   Json?
  showDate   Boolean   @default(false)
  showTime   Boolean   @default(false)
  /// Where the poster dragged each sticker: { ask, gif, location, date, time } of { x, y, scale }.
  positions  Json?
  /// What the poster drew on top: { strokes, texts }, placed as fractions of the story.
  drawing    Json?
  /// An anonymous message the poster shared on it, as a card: { text, prompt }.
  ask        Json?
  createdAt  DateTime  @default(now())
  expiresAt  DateTime

  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  upload Upload?     @relation(fields: [uploadId], references: [id], onDelete: SetNull)
  views  StoryView[]

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

/// A short line someone shows above their picture to their contacts for a day; a new one replaces it.
model Note {
  id        String   @id @default(cuid())
  userId    String   @unique
  text       String
  background String?
  gifKey     String?
  gifWidth   Int?
  gifHeight  Int?
  createdAt  DateTime @default(now())
  expiresAt  DateTime

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  views NoteView[]
}

model NoteView {
  noteId    String
  userId    String
  viewedAt  DateTime @default(now())
  /// The emojis they reacted with, as on StoryView.
  reactions String[] @default([])

  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([noteId, userId])
  @@index([userId])
}

model StoryView {
  storyId  String
  userId   String
  viewedAt DateTime @default(now())
  /// The emojis they reacted with, oldest first and at most the last 30, shown to the poster only, never sent as messages.
  reactions String[] @default([])

  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([storyId, userId])
  @@index([userId])
}

/// Something someone did that concerns the user, for their notifications tab. The worker drops them after 30 days.
model Notification {
  id        String   @id @default(cuid())
  userId    String
  /// Null for an anonymous message: nobody is named.
  actorId   String?
  /// joined, added, story_reaction, note_reaction, story_reply, missed_call or anon_message.
  kind      String
  chatId    String?
  emoji     String?
  video     Boolean  @default(false)
  /// Set when they marked it unread again; it stays unread until they open it or mark it read.
  markedUnread Boolean @default(false)
  createdAt DateTime @default(now())

  user  User @relation("notified", fields: [userId], references: [id], onDelete: Cascade)
  actor User? @relation("notifier", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([createdAt])
}

/// Someone nudging a contact by email to come back to Six Frites.
model Poke {
  id        String   @id @default(cuid())
  fromId    String
  toId      String
  message   String?
  createdAt DateTime @default(now())

  from User @relation("poker", fields: [fromId], references: [id], onDelete: Cascade)
  to   User @relation("poked", fields: [toId], references: [id], onDelete: Cascade)

  @@index([fromId, createdAt])
  @@index([toId, createdAt])
}

/// Every email the app tried to send, for the admin page; kept 90 days.
model MailLog {
  id        String   @id @default(cuid())
  /// poke, inactive or anon.
  kind      String
  /// sent, failed, or skipped when mail isn't set up.
  status    String
  subject   String
  to        String
  /// Where it really went, when redirected outside production.
  sentTo    String?
  error     String?
  userId    String?
  /// Who caused it, such as whoever poked.
  fromId    String?
  createdAt DateTime @default(now())

  user User? @relation("mailed", fields: [userId], references: [id], onDelete: SetNull)
  from User? @relation("mailCause", fields: [fromId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([kind, createdAt])
}
