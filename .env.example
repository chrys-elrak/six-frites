NODE_ENV=development
PORT=4000
PUBLIC_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:3000

DATABASE_URL=postgresql://six:six@localhost:5432/six
REDIS_URL=redis://localhost:6379

GOOGLE_CLIENT_IDS=your-web-client-id.apps.googleusercontent.com
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
BACKUP_PIN_SECRET=change-me-to-another-long-random-string-32-chars

S3_ENDPOINT=http://localhost:8333
S3_PUBLIC_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=six-media
S3_ACCESS_KEY=six
S3_SECRET_KEY=six-dev-secret-key

# Generate with: npx web-push generate-vapid-keys
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:you@example.com

# Android push: a Firebase service account key (Project settings > Service accounts), the whole JSON in
# single quotes on one line. Leave empty to turn Android push off.
FCM_SERVICE_ACCOUNT=

# GIF search (https://developers.giphy.com). Leave empty to hide GIFs.
GIPHY_API_KEY=

# Comma-separated emails that get the moderation UI at /admin.
ADMIN_EMAILS=
